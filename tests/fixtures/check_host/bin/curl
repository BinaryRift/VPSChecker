#!/usr/bin/env bash

set -u

readonly FIXTURES_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [[ ${VPSCHECK_CHECK_HOST_FAILURE:-0} == 1 ]]; then
    exit 22
fi
if [[ ${VPSCHECK_CHECK_HOST_INVALID_JSON:-0} == 1 ]]; then
    printf 'not-json\n'
    exit 0
fi

command cat "$FIXTURES_DIR/nodes.json"
