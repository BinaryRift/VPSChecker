#!/usr/bin/env bash

set -u

output_file=''
while (( $# > 0 )); do
    case $1 in
        --output)
            output_file=$2
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z $output_file ]]; then
    printf '198.51.100.24\n'
    exit 0
fi

printf '%s\n' \
    '#!/usr/bin/env bash' \
    '# Runtime resource example: ${rawgithub}main/ref/example.json' \
    "printf '{\"Head\":{\"IP\":\"203.0.113.10\"},\"Info\":{},\"Score\":{},\"Factor\":{}}\\n'" \
    > "$output_file"
if [[ -n ${VPSCHECK_MOCK_PATH_LOG:-} ]]; then
    printf '%s\n' "$output_file" > "$VPSCHECK_MOCK_PATH_LOG"
fi
