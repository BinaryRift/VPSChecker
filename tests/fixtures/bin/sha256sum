#!/usr/bin/env bash

set -u

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly PROJECT_DIR=$(cd "$SCRIPT_DIR/../../.." && pwd)

file=''
for argument in "$@"; do
    file=$argument
done

checksum=$(sed -n 's/^readonly IPQUALITY_SHA256=//p' "$PROJECT_DIR/lib/ipquality.sh")
printf '%s  %s\n' "$checksum" "$file"
